{
  "name": "Daily",
  "short_name": "Daily",
  "description": "Habit, routine, life calendar, heatmap, and Eisenhower matrix app.",
  "id": "/",
  "start_url": "/#/today",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#071312",
  "theme_color": "#071312",
  "categories": ["productivity", "lifestyle"],
  "lang": "ko-KR",
  "icons": [
    {
      "src": "/icons/daily-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/daily-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/daily-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "오늘",
      "short_name": "오늘",
      "url": "/#/today"
    },
    {
      "name": "캘린더",
